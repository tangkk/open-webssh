{
  "targets": [
    {
      "id": "primary",
      "label": "Primary host",
      "host": "127.0.0.1",
      "port": 2222,
      "user": "remote-user",
      "knownHostsFile": "/etc/webssh/known_hosts-primary",
      "tmuxBin": "tmux",
      "capabilities": { "tmux": true, "agents": true },
      "extraAgent": {
        "buttonLabel": "O",
        "label": "Optional agent",
        "launchCommand": "optional-agent",
        "commands": [
          { "id": "help", "label": "/help", "description": "Show available commands", "command": "/help" },
          { "id": "sessions", "label": "/sessions", "description": "Browse sessions", "command": "/sessions" }
        ]
      }
    },
    {
      "id": "secondary",
      "label": "Secondary host",
      "host": "127.0.0.1",
      "port": 2223,
      "user": "remote-user",
      "knownHostsFile": "/etc/webssh/known_hosts-secondary",
      "capabilities": { "tmux": false, "agents": false }
    }
  ]
}
